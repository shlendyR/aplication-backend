// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String   @default("Unknown") @db.VarChar(50)
  phone     String?  @unique @db.VarChar(20)
  password  String
  birthdate DateTime
  id_role   Int
  //relaciones
  role      role     @relation(fields: [id_role], references: [id_role]) // relacion donde actua la forania
  sales     Sale[]
}

model role {
  id_role   Int    @id @default(autoincrement())
  name_role String @unique @db.VarChar(50)
  //relaciones
  users     User[] // "Un rol puede tener varios usuarios asociados." 
}

model Product {
  id          Int     @id @default(autoincrement())
  description String  @unique @default("No description") @db.VarChar(100) // descripción con límite razonable
  price_sale  Decimal @db.Decimal(10, 2) // precio con 2 decimales, formato estándar
  cost_price  Decimal @db.Decimal(10, 2)
  stock       Int     @default(0) // stock con valor por defecto
  id_category Int?

  category    Category?    @relation(fields: [id_category], references: [id], onDelete: SetNull) // relacion donde actua la forania
  saleDetails SaleDetail[] // "Un producto puede tener varios detalles de venta asociados."
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(50)
  //relaciones
  products Product[] // "Una categoria puede tener varios productos asociados."
}

model Sale {
  id             Int           @id @default(autoincrement())
  date           DateTime      @default(now())
  total          Decimal       @db.Decimal(10, 2)
  description    String?
  status         SaleStatus
  payment_method PaymentMethod
  id_user        Int?

  user               User?                @relation(fields: [id_user], references: [id], onDelete: SetNull)
  saleDetails        SaleDetail[]
  accountsReceivable AccountsReceivable[]
}

model SaleDetail {
  id         Int     @id @default(autoincrement())
  amount     Int
  subtotal   Decimal @db.Decimal(10, 2)
  id_product Int
  id_sale    Int

  product Product @relation(fields: [id_product], references: [id], onDelete: Restrict)
  sale    Sale    @relation(fields: [id_sale], references: [id], onDelete: Cascade)
}

model AccountsReceivable {
  id              Int      @id @default(autoincrement())
  expiration_date DateTime
  id_sale         Int

  sale     Sale      @relation(fields: [id_sale], references: [id], onDelete: Cascade)
  payments Payment[]
}

model Payment {
  id                     Int           @id @default(autoincrement())
  id_accounts_receivable Int
  amount_paid            Decimal       @db.Decimal(10, 2)
  payment_date           DateTime      @default(now())
  payment_method         PaymentMethod

  accountReceivable AccountsReceivable @relation(fields: [id_accounts_receivable], references: [id], onDelete: Cascade)
}

enum SaleStatus {
  PENDING
  COMPLETED
}

enum PaymentMethod {
  TRANSFER
  CASH
  CARD
}
